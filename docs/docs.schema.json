{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/docFile",
  "$defs": {
    "docFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docFunc"
          }
        }
      }
    },
    "docFunc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "environ": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "preCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "template": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "template"
      ]
    }
  }
}